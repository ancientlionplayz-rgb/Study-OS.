# StudyOS Configuration (Standalone Project)
# DO NOT point this to any LMS database (e.g. Astha D Destiny LMS).
# Create a separate, dedicated Supabase project for StudyOS.

# Supabase Standalone Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-studyos-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-studyos-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-studyos-service-role-key

# Gemini API Key (Optional for live Socratic Coach; falls back to deterministic engine if not set)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
